# Server-only secrets. Never prefix these with VITE_ (that would put them in
# the browser bundle). On Render, add them as Environment Variables (not
# Secret Files). The browser never talks to Supabase directly.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx
METALCHARTS_API_KEY=
API_NINJAS_KEY=

# Reminders (M6). JOB_TOKEN: a long random value (e.g. `openssl rand -hex 32`);
# the same value goes in the GitHub secret JOB_TOKEN. BREVO_SENDER_EMAIL is
# the sender address verified in Brevo.
JOB_TOKEN=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=

# Only for `npm run test:access` on your own machine. Not needed on Render.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# APP_URL=http://localhost:3000
